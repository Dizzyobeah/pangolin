# To see all available options, please visit the docs:
# https://docs.pangolin.net/

gerbil:
    start_port: 51820
    base_endpoint: "${PANGOLIN_PREFIX}.${DOMAIN}"

app:
    dashboard_url: "https://${PANGOLIN_PREFIX}.${DOMAIN}"
    log_level: "info"
    telemetry:
        anonymous_usage: true

domains:
    domain1:
        base_domain: "${DOMAIN}"

server:
    secret: "<GENERATE: openssl rand -hex 32>"
    cors:
        origins: ["https://${PANGOLIN_PREFIX}.${DOMAIN}"]
        methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
        allowed_headers: ["X-CSRF-Token", "Content-Type"]
        credentials: false
flags:
    require_email_verification: false
    disable_signup_without_invite: true
    disable_user_create_org: false
    allow_raw_resources: false  # NEVER true: public raw TCP bypasses auth

